# Repository being read by the GitHub traffic API
GITHUB_REPOSITORY=owner/repository

# Optional token. GITHUB_TOKEN works for workflow auth; a PAT may be needed if the API rejects the workflow token.
TRAFFIC_TOKEN=

# Badge settings
INPUT_COUNT_TYPE=count
INPUT_BADGE_LABEL=Profile views
INPUT_BADGE_COLOR=blue
INPUT_BADGE_STYLE=flat
INPUT_BASE_COUNT=0
INPUT_ABBREVIATED=false
OUTPUT_PATH=public/views.svg
